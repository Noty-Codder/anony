# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on telegram
BOT_TOKEN=
LOGGER_ID=

# mongo url from cloud.mongodb.com (main bot + every clone use their own database inside it)
MONGO_URL=

OWNER_ID=
OWNER_USERNAME=

# pyrogram session from @StringFatherBot on telegram (SESSION2 / SESSION3 optional)
SESSION=
SESSION2=
SESSION3=

# --- optional ---
# ERROR_LOGGER_ID=        # group where tracebacks are reported
# CLONE_LOGGER=           # group for clone logs (defaults to LOGGER_ID)
# CLONE_FSUB=True         # users must join FSUB_CHANNEL / FSUB_GROUP before /clone
# FSUB_CHANNEL=
# FSUB_GROUP=
# UI_COLORS=True          # random blue / green / red buttons
# UI_BLOCKQUOTE=True      # every message inside a blockquote card
# UI_FONT=True            # small-caps premium font on buttons
# PREMIUM_EMOJI=False     # premium custom emoji (only if your bots can use them)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
